[Unit]
Description=OpenKFO Cloudflare Tunnel
After=network-online.target kungfu-go.service
Wants=network-online.target
ConditionPathExists=/etc/openkfo-tunnel/token

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tunnel-token:/etc/openkfo-tunnel/token
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 run --token-file ${CREDENTIALS_DIRECTORY}/tunnel-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
